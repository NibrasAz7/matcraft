<?xml version="1.0" encoding="utf-8"?>
<!--
  MatCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the WixUI extension:
  `wix extension add -g WixToolset.UI.wixext/5.0.2`). Built by package.ps1:

    wix build matcraft.wxs -arch x64 -ext WixToolset.UI.wixext -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, an optional desktop shortcut, and
  MatCraft offered under "Open with" for .m scripts (without taking over the user's default app).

  Desktop shortcut: the setup wizard asks (unchecked by default). Silent installs leave it out
  unless asked: `msiexec /i matcraft.msi /qn DESKTOPSHORTCUT=1`. Upgrades keep the previous choice
  unless DESKTOPSHORTCUT=1 or DESKTOPSHORTCUT=0 is given.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MatCraft"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="747AC924-258F-487C-B2BA-0A7D3513E15E"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="MatCraft numerical computing environment" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of MatCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="MatcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MatcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/matcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/matcraft" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MatCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <!-- Per-machine (ALLUSERS=1), so this is the all-users (Public) desktop, like the Start Menu above. -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- "Create a desktop shortcut": the wizard's checkbox sets it to 1 (cleared = unset), and
         silent installs pass DESKTOPSHORTCUT=1. Secure, so the elevated install sees the UI choice. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <!-- The previous install's choice (the shortcut component's HKCU key path, so the installing
         user's), so upgrades keep the desktop shortcut without asking again. -->
    <Property Id="PREVIOUSDESKTOPSHORTCUT">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="HKCU" Key="Software\Learning Machines LLC\MatCraft"
          Name="DesktopShortcut" Type="raw" />
    </Property>
    <!-- Only when DESKTOPSHORTCUT wasn't given; "first" runs it once (in the UI sequence when there
         is one), so unticking the box isn't undone by the execute sequence. -->
    <SetProperty Id="DESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT DESKTOPSHORTCUT AND PREVIOUSDESKTOPSHORTCUT = &quot;1&quot;" />

    <UIRef Id="MatcraftUI" />

    <Feature Id="Main" Title="MatCraft" Level="1">
      <ComponentGroupRef Id="MatcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="MatcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="MatcraftApp" Guid="65D4D79D-2232-4D23-BE8A-700A46A19108">
        <File Id="MatcraftExe" Source="$(var.BinDir)\matcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="MatCraft"
              Description="MatCraft numerical computing environment" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="MatcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\matcraft.exe" Value="[#MatcraftExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\matcraft.exe\shell\open\command" Value="&quot;[#MatcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.m\OpenWithProgids" Name="MatCraft.Script" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\MatCraft.Script\shell\open\command" Value="&quot;[#MatcraftExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="MatcraftCli">
        <File Id="MatcraftCliExe" Source="$(var.BinDir)\matcraft-cli.exe" KeyPath="yes" />
      </Component>

      <!-- Optional desktop shortcut, removed on uninstall. A non-advertised shortcut needs a registry
           key path, and one in a profile folder (DesktopFolder, even though ALLUSERS=1 makes it the
           Public desktop) must be under HKCU (ICE38, ICE43, ICE57). -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="37DFD228-BBCE-4F26-AC0F-5A58346061E2"
          Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="MatCraft" Description="MatCraft numerical computing environment"
            Target="[INSTALLFOLDER]matcraft.exe" WorkingDirectory="INSTALLFOLDER" Icon="MatcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\MatCraft" Name="DesktopShortcut"
            Value="1" Type="string" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!--
    Setup wizard: WixUI_InstallDir's flow (WiX v5, ext/UI/wixlib/WixUI_InstallDir.wxs) without the
    licence and folder pages, plus a Shortcuts page:
      install:     Welcome > Shortcuts > Ready to install > Progress > Finish
      maintenance: Maintenance welcome > Repair/Remove > Ready > Progress > Finish
  -->
  <Fragment>
    <UI Id="MatcraftUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
            Text="Choose where to start [ProductName] from." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
            Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="StartMenuText" Type="Text" X="20" Y="60" Width="330" Height="15" NoPrefix="yes"
            Text="[ProductName] will be added to the Start menu." />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="85" Width="330" Height="17"
            Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <!-- No "Change" in Apps & features: there is a single feature. -->
      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
